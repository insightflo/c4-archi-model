{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c4-archi-model.local/schema/skill-package-manifest-0.4.0.json",
  "title": "c4-archi-model Skill Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "version",
    "entrypoint",
    "language",
    "agentIndependent",
    "runtime",
    "requiredFiles",
    "forbiddenPatterns",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "packageName": {
      "const": "c4-archi-model"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entrypoint": {
      "const": "SKILL.md"
    },
    "language": {
      "const": "ko"
    },
    "agentIndependent": {
      "const": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "externalPackagesRequired"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "externalPackagesRequired": {
          "const": false
        }
      }
    },
    "requiredFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbiddenPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
