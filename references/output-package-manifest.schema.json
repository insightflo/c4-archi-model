{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c4-archi-model.local/schema/output-package-manifest-0.4.0.json",
  "title": "C4 Output Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "title",
    "packageVersion",
    "generatedAt",
    "entryPoint",
    "paths",
    "files",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4.0"
    },
    "packageId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "packageVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entryPoint": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "model",
        "evidence",
        "coverage",
        "understanding",
        "reportData",
        "handoff"
      ],
      "properties": {
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": [
            "string",
            "null"
          ]
        },
        "understanding": {
          "type": [
            "string",
            "null"
          ]
        },
        "reportData": {
          "type": [
            "string",
            "null"
          ]
        },
        "handoff": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "validatedAt",
        "validatorVersion",
        "reportPath"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "validatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "validatorVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "reportPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "derivation": {
      "enum": [
        "explicit",
        "normalized",
        "inferred",
        "unresolved"
      ]
    },
    "confidence": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "DOC_ONLY",
        "UNVERIFIED",
        "CONFLICT"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "required",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
